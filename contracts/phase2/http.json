    "/api/reclaim/overview": {
      "get": {
        "summary": "허용 범위의 마지막 점검·후보·미읽음 알림",
        "description": "Implemented server handler. Asynchronous completion requires running the v2 Worker and MCP services.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "last_run",
                    "active_run",
                    "summary",
                    "targets"
                  ],
                  "properties": {
                    "last_run": {
                      "anyOf": [
                        {
                          "$ref": "./schema.json#/$defs/ReclaimRunView"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "active_run": {
                      "anyOf": [
                        {
                          "$ref": "./schema.json#/$defs/ReclaimRunView"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "summary": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "Final server aggregates; null before first scan or when the latest result is unconfirmed.",
                      "properties": {
                        "review_target_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "new_candidate_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "newly_notified_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "needs_review_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "unread_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "unknown_cost_target_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "monthly_saving_by_currency": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    },
                    "targets": {
                      "type": "array",
                      "items": {
                        "$ref": "./schema.json#/$defs/ReclaimCandidate"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Outside permitted organization/role"
          },
          "404": {
            "description": "Not found in permitted scope"
          },
          "409": {
            "description": "State, plan hash, or idempotency conflict"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
