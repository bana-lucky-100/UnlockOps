# UnlockOps .gitignore
# 항목별로 규칙을 추가하거나 주석 처리할 수 있습니다.
# /로 시작하는 경로는 레포 루트 기준이며, 나머지는 하위 폴더에도 적용됩니다.
# 이미 추적 중인 파일에는 적용되지 않습니다.

# ==================================================
# 1. OS 임시 파일
# ==================================================
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==================================================
# 2. IDE / 편집기 (IntelliJ, VS Code, Eclipse)
# ==================================================
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.sts4-cache/
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
!**/.vscode/*.code-snippets
*.swp
*.swo
*~

# ==================================================
# 3. 환경변수 / 로컬 비밀 설정
# ==================================================
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
/secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ==================================================
# 4. Vue / Node.js / Vite
# ==================================================
node_modules/
.npm/
.pnpm-store/
.vite/
.vite-temp/
/frontend/dist/
/frontend/dist-ssr/
*.tsbuildinfo
.eslintcache
.stylelintcache
# package-lock.json, pnpm-lock.yaml, yarn.lock는 추적합니다.

# ==================================================
# 5. Spring Boot / Java / Gradle / Maven
# ==================================================
.gradle/
.m2/
/backend/**/build/
/backend/**/target/
/backend/**/out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
# 빌드 도구 Wrapper는 함께 커밋합니다.
!**/gradle/wrapper/gradle-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar
# 로컬 비밀 설정만 제외합니다. 공통 application.yml 등은 추적합니다.
application-local.yml
application-local.yaml
application-local.properties
application-secret.yml
application-secret.yaml
application-secret.properties

# ==================================================
# 6. Python / 가상환경 / 패키지 빌드
# ==================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/
.python-version.local
*.egg-info/
*.egg
.eggs/
/build/
/dist/
/agent/**/build/
/agent/**/dist/
/rag/**/build/
/rag/**/dist/
/mcp/**/build/
/mcp/**/dist/
/worker/**/build/
/worker/**/dist/
.pip-cache/
.uv-cache/
.pypirc
.ipynb_checkpoints/
# requirements*.txt, pyproject.toml, uv.lock, poetry.lock, Pipfile.lock는 추적합니다.
# 실습 노트북(.ipynb)도 추적합니다.

# ==================================================
# 7. 테스트 / 코드 검사 결과
# ==================================================
coverage/
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
/test-results/
/frontend/test-results/
/frontend/playwright-report/

# ==================================================
# 8. LangChain / LangGraph 로컬 실행 상태
# ==================================================
.langgraph_api/
.langchain.db
.langchain.db-*
langchain.db
langchain.db-*
# langgraph.json, 그래프 코드, 프롬프트, 평가 입력은 추적합니다.

# ==================================================
# 9. RAG / 생성된 색인 / 임베딩 / 모델 캐시
# ==================================================
.cache/
.chroma/
/rag/chroma_db/
/rag/faiss_index/
/rag/indexes/
/rag/embeddings/
/data/cache/
/data/indexes/
/data/embeddings/
/data/vectorstore/
/data/models/
/data/checkpoints/
/data/runtime/
/data/private/
/data/uploads/
# 이식 전 실행 경로와 로컬 CHECKPOINT_PATH에서 사용하는 상태 파일입니다.
/runtime/
/state/
/checkpoints.sqlite
/checkpoints.sqlite-*
# 로컬 DB는 위 생성물 폴더에 저장합니다.
# *.db, *.sqlite*, *.pkl, *.faiss는 일괄 제외하지 않습니다.
# data의 데모 정책, 샘플 데이터, 원본 문서, 출처 목록은 추적합니다.

# ==================================================
# 10. Docker / RabbitMQ / DB 로컬 실행 데이터
# ==================================================
/infra/volumes/
/infra/runtime/
/infra/.data/
/infra/rabbitmq/data/
/infra/postgres/data/
/infra/redis/data/
# compose.yaml, Dockerfile, 초기화 스크립트, RabbitMQ 설정은 추적합니다.

# ==================================================
# 11. 로그 / 프로세스 / 임시 파일
# ==================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
/tmp/
/temp/
