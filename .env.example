# UnlockOps 로컬 환경변수 예시
# 1. 레포 루트에서 .env로 복사한 뒤 필요한 항목만 수정합니다.
# 2. 비밀값은 비워 두었습니다. 실제 값은 .env에만 입력합니다.
# 3. 주소와 포트는 로컬 개발 제안값입니다. 서비스 구현 시 확정합니다.
# 4. 이 파일을 복사하는 것만으로 각 서비스에 환경변수가 주입되지는 않습니다.
#    서비스 실행 설정, 환경변수 전달 또는 명시적인 dotenv 로딩이 필요합니다.

# ==================================================
# 1. 공통 실행 설정 (사용 시 서비스 코드에서 읽기)
# ==================================================
TZ=Asia/Seoul
LOG_LEVEL=INFO

# ==================================================
# 2. Frontend / Vue / Vite
# ==================================================
# Vite 프로젝트 초기화 후 frontend/.env.local에 필요한 VITE_* 값만 복사합니다.
# VITE_* 값은 브라우저에 공개됩니다. API 키와 비밀번호를 넣지 않습니다.
VITE_API_BASE_URL=http://localhost:8080

# ==================================================
# 3. Backend / Spring Boot
# ==================================================
# Spring Boot 표준 환경변수입니다. 실행 프로세스에 전달해야 적용됩니다.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# CORS는 backend 설정에서 명시적으로 연결할 프로젝트 공통 변수입니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==================================================
# 4. 인증 (JWT 방식을 채택한 경우 주석을 해제하고 연결)
# ==================================================
# JWT_SECRET=
# JWT_EXPIRATION_SECONDS=3600

# ==================================================
# 5. 업무 DB (종류 미확정 / PostgreSQL을 선택한 경우의 예시)
# ==================================================
# Spring의 JDBC 설정과 DB 드라이버를 준비한 뒤 필요한 줄의 주석을 해제합니다.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unlockops
# SPRING_DATASOURCE_USERNAME=unlockops
# SPRING_DATASOURCE_PASSWORD=

# ==================================================
# 6. RabbitMQ / Spring Boot
# ==================================================
# 브로커를 구성할 때 같은 계정과 vhost를 생성해야 합니다.
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=unlockops
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/
# Python worker에서 사용할 연결 URL입니다. 인증값 확정 후 입력합니다.
# 예: amqp://unlockops:<URL로 인코딩한 비밀번호>@localhost:5672/%2F
RABBITMQ_URL=

# ==================================================
# 7. Agent / LangChain / LLM (OpenAI를 선택한 경우의 예시)
# ==================================================
# 모델 이름은 실습에서 사용할 모델을 정한 후 입력합니다.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# Agent/worker가 backend를 호출할 때 사용할 프로젝트 공통 변수입니다.
BACKEND_API_BASE_URL=http://localhost:8080

# ==================================================
# 8. LangSmith (선택 사항 / 사용하지 않으면 false 유지)
# ==================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=unlockops-local

# ==================================================
# 9. MCP 서버 연결 (HTTP 전송 방식을 채택한 경우 입력)
# ==================================================
# URL과 경로는 서버 구현 후 확정합니다. stdio를 사용하면 별도 실행 설정으로 관리합니다.
BUSINESS_MCP_URL=
RAG_MCP_URL=

# ==================================================
# 10. RAG 데이터 경로 (서비스 코드에서 읽기)
# ==================================================
# 아래 경로는 레포 루트 기준 제안값입니다. 해당 폴더는 아직 생성하지 않았습니다.
# 구현 시 레포 루트를 기준으로 해석하거나 로컬 .env에서 절대경로로 바꿉니다.
RAG_DOCUMENT_DIR=./data/documents
RAG_INDEX_DIR=./data/indexes
# data/documents의 원본 문서는 추적하고 data/indexes의 생성물은 제외합니다.
