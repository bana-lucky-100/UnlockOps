# UnlockOps local demo configuration. Do not expose demo credentials publicly.
# cp .env.example .env
# Python loads the root .env; Compose reads it for interpolation.
# Spring outside Compose needs exported environment variables or the VS Code launch profile.
TZ=Asia/Seoul
LOG_LEVEL=INFO
AGENT_MODE=demo

POSTGRES_DB=unlockops
POSTGRES_USER=unlockops
POSTGRES_PASSWORD=unlockops-local-only
RABBITMQ_USER=unlockops
RABBITMQ_PASSWORD=unlockops-local-only
DEMO_ENABLED=true
DEMO_PASSWORD=demo1234
MCP_TOKEN=replace-this-local-mcp-token
# Spring /internal/** local service token, managed like MCP_TOKEN.
# Replace for deployment; MCP integration is not enabled yet.
INTERNAL_API_TOKEN=replace-this-local-internal-api-token

# Optional overrides for LOCAL Python processes; Compose sets container hosts itself.
# DATABASE_URL=postgresql://unlockops:unlockops-local-only@localhost:5432/unlockops
# DB_HOST=localhost
# DB_NAME=unlockops
# DB_USER=unlockops
# DB_PASSWORD=unlockops-local-only
# RABBIT_URL=amqp://unlockops:unlockops-local-only@localhost:5672/
POLICY_MCP_URL=http://localhost:8001/mcp
BUSINESS_MCP_URL=http://localhost:8002/mcp
# MCP_HOST/MCP_PORT: set per server; defaults are 127.0.0.1:8001 and :8002.

# All relative Python paths are resolved from the repository root, not the terminal cwd.
DATA_DIR=./data
CHECKPOINT_PATH=./data/checkpoints/checkpoints.sqlite

# LLM is optional; demo mode makes no paid model requests.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Both embedding URL and model must be set together; empty means local TF-IDF.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional tracing. Keep off during local tests.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=unlockops-local

# Spring standard environment overrides remain supported by Spring Boot.
SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unlockops
# SPRING_DATASOURCE_USERNAME=unlockops
# SPRING_DATASOURCE_PASSWORD=unlockops-local-only
# SPRING_RABBITMQ_HOST=localhost
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=unlockops
# SPRING_RABBITMQ_PASSWORD=unlockops-local-only

# Vite proxies /api to the local backend. Copy frontend-only settings to frontend/.env.local.
# VITE_* is public browser configuration; never place secrets there.
