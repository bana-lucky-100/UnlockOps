# UnlockOps local demo configuration. Do not expose demo credentials publicly.
# cp .env.example .env
# Python loads the root .env; Compose reads it for interpolation, not env_file.
# Spring outside Compose needs exported variables or the VS Code launch profile.
# Scope, defaults, precedence and audit: docs/environment.md
AGENT_MODE=demo

# Shared local database/broker credentials. Compose maps these to container settings.
POSTGRES_DB=unlockops
POSTGRES_USER=unlockops
POSTGRES_PASSWORD=unlockops-local-only
RABBITMQ_USER=unlockops
RABBITMQ_PASSWORD=unlockops-local-only

# LOCAL Spring DB / Spring and Worker broker overrides of the shared settings.
# Compose fixes DB/broker hosts and uses the shared credentials above.
# DB_URL=jdbc:postgresql://localhost:5432/unlockops
# DB_USER=unlockops
# DB_PASSWORD=unlockops-local-only
# RABBIT_HOST=localhost
# RABBIT_USER=unlockops
# RABBIT_PASSWORD=unlockops-local-only
# Worker only; Spring uses SPRING_RABBITMQ_PORT instead.
# RABBIT_PORT=5672

DEMO_ENABLED=true
DEMO_PASSWORD=demo1234
# Standalone Spring: set an absolute path to prepare A/B demo data and policy revisions.
# Compose fixes DEMO_ENABLED=true and DEMO_SEED_PATH to the mounted path.
# DEMO_SEED_PATH=/absolute/path/to/UnlockOps/data/phase2/seed.sql
# Legacy Spring-only alias; DEMO_SEED_PATH takes precedence when set.
# DEMO_PHASE2_SEED_PATH=/absolute/path/to/UnlockOps/data/phase2/seed.sql

# Enable only with the Worker connected and the intended reclaim_scopes.enabled=true.
RECLAIM_SCHEDULE_ENABLED=false
# Spring six-field cron; scheduler timezone is fixed to Asia/Seoul.
RECLAIM_CRON="0 0 9 * * *"
# Legacy aliases for standalone Spring only; RECLAIM_* takes precedence when set.
# Compose does not forward PHASE2_* aliases. Migrate existing .env to RECLAIM_*.
# PHASE2_RECLAIM_SCHEDULE_ENABLED=false
# PHASE2_RECLAIM_CRON="0 0 9 * * *"

MCP_TOKEN=replace-this-local-mcp-token
# MCP -> Spring /internal/**; use the same token in both services.
INTERNAL_API_TOKEN=replace-this-local-internal-api-token
# Local MCP only; Compose fixes the backend URL to http://backend:8080.
BACKEND_INTERNAL_URL=http://localhost:8080

# LOCAL Python connections; Compose fixes the container service URLs itself.
# Worker: nonempty RABBIT_URL > RABBITMQ_URL > host/port/user/password above.
# RABBIT_URL=amqp://unlockops:unlockops-local-only@localhost:5672/
# RABBITMQ_URL=amqp://unlockops:unlockops-local-only@localhost:5672/
POLICY_MCP_URL=http://localhost:8001/mcp
BUSINESS_MCP_URL=http://localhost:8002/mcp
# Set MCP_HOST/MCP_PORT per server process, not globally for both servers.
# Policy defaults to 127.0.0.1:8001; Business to 127.0.0.1:8002.
# MCP_HOST=127.0.0.1
# MCP_PORT=8001

# Relative Python paths resolve from the repository root, not the terminal cwd.
# DATA_DIR is retained in Settings; the current workflow does not use this field.
DATA_DIR=./data
# Local Worker only; Compose fixes this to /state/checkpoints.sqlite.
CHECKPOINT_PATH=./data/checkpoints/checkpoints.sqlite

# LLM is optional; AGENT_MODE=demo makes no paid model requests.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# DocumentIndex utility only; current revision-scoped policy search uses local TF-IDF.
# Both embedding URL and model must be set together. Compose forwards these to MCP.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional LangSmith library configuration for local Python, not forwarded by Compose.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=unlockops-local

# Spring Boot standard overrides for standalone Spring (higher priority than YAML).
# Changing the server port also requires updating local clients/proxy configuration.
SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unlockops
# SPRING_DATASOURCE_USERNAME=unlockops
# SPRING_DATASOURCE_PASSWORD=unlockops-local-only
# SPRING_RABBITMQ_HOST=localhost
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=unlockops
# SPRING_RABBITMQ_PASSWORD=unlockops-local-only

# Frontend only: copy the needed line to frontend/.env.local, then restart Vite/build.
# The root .env is not loaded by Vite. VITE_* is public; never place secrets there.
# VITE_UO_MOCK=false

# Optional live test only; use a fresh, dedicated demo stack (writes requests/approvals).
# Pass these as process variables; leave RUN_LIVE_STACK unset for ordinary tests.
# RUN_LIVE_STACK=1
# LIVE_BASE_URL=http://localhost:8088
